<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:loc="using:BorderlessMouse.Localization"
             x:Class="BorderlessMouse.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <!-- Fluent Design v2 / WinUI 3 (FluentAvalonia): motyw i kolor akcentu z systemu -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <StyleInclude Source="avares://BorderlessMouse/Styles/Theme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://BorderlessMouse/Assets/icon.png"
                      ToolTipText="BorderlessMouse"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{x:Static loc:L10n.ShowWindow}" Click="ShowWindow_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static loc:L10n.Quit}" Click="Exit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>

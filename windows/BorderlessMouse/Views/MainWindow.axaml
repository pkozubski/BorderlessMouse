<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:vm="using:BorderlessMouse.ViewModels"
               xmlns:pages="using:BorderlessMouse.Views.Pages"
               x:Class="BorderlessMouse.Views.MainWindow"
               x:DataType="vm:MainViewModel"
               Title="BorderlessMouse"
               Icon="avares://BorderlessMouse/Assets/icon.png"
               Width="920" Height="660"
               MinWidth="760" MinHeight="540"
               WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="32,*">

        <!-- Pasek tytułu (obszar przeciągania okna): ikona + nazwa jak w aplikacjach Windows 11 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,0,150,0">
            <Image Source="avares://BorderlessMouse/Assets/icon.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="BorderlessMouse" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="pill" Padding="8,2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pasek boczny (WinUI 3 NavigationView) + zawartość strony -->
        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           CompactModeThresholdWidth="0"
                           ExpandedModeThresholdWidth="700"
                           IsBackButtonVisible="False"
                           IsSettingsVisible="False"
                           SelectionChanged="Nav_OnSelectionChanged">

            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,0,10">
                    <Image Source="avares://BorderlessMouse/Assets/logo.png" Width="36" Height="36" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BorderlessMouse" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Windows" Classes="subtitle" />
                    </StackPanel>
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Połączenie" Tag="connection">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource Glyph="&#xE839;" FontFamily="{StaticResource IconFont}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Sterowanie" Tag="control">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource Glyph="&#xE765;" FontFamily="{StaticResource IconFont}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Ustawienia" Tag="settings">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource Glyph="&#xE713;" FontFamily="{StaticResource IconFont}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Dziennik" Tag="log">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource Glyph="&#xE7C3;" FontFamily="{StaticResource IconFont}" />
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <TextBlock Text="{Binding VersionLabel}" Classes="subtitle" Margin="16,0,0,12" />
            </ui:NavigationView.PaneFooter>

            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Komunikaty globalne – widoczne na każdej stronie -->
                <ui:InfoBar Grid.Row="0" Margin="24,8,24,0"
                            IsOpen="{Binding UpdateAvailable}"
                            Severity="Informational"
                            Title="Dostępna aktualizacja"
                            Message="{Binding UpdateMessage}"
                            IsClosable="True">
                    <ui:InfoBar.ActionButton>
                        <Button Content="Zainstaluj i uruchom ponownie" Command="{Binding InstallUpdateCommand}" />
                    </ui:InfoBar.ActionButton>
                </ui:InfoBar>
                <ui:InfoBar Grid.Row="1" Margin="24,8,24,0"
                            IsOpen="{Binding MacAccessibilityMissing}"
                            Severity="Warning"
                            Title="Mac nie ma uprawnienia Dostępność"
                            Message="Sterowanie nie zadziała, dopóki na Macu nie nadasz BorderlessMouse uprawnienia w Ustawieniach systemowych (Prywatność i ochrona, sekcja Dostępność)."
                            IsClosable="False" />

                <ContentControl Grid.Row="2" x:Name="PageHost" />
            </Grid>
        </ui:NavigationView>
    </Grid>
</wnd:AppWindow>
